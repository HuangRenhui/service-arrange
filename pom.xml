<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hrh</groupId>
    <artifactId>service-arrange</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>service-arrange</name>
    <description>
        服务编排平台（Service Arrangement）：
        基于 DSL 的可视化服务编排引擎，将分散的服务通过可视化编排的 JSON（DSL）串成可执行流程，
        提供 DSL 解析、任务调度执行、实例状态与日志记录、失败补偿、循环与条件分支能力。

        模块划分：
            backend/engine：核心引擎，包含 DSL 解析、任务调度、算子执行与持久化；
            backend/web   ：Web 接入层，提供 REST 接口与启动类；
            frontend      ：可视化编排控制台（纯静态，零依赖）。
    </description>
    <modules>
        <module>backend</module>
    </modules>

    <properties>
        <!-- 依赖版本号管理 -->
        <spring-boot.version>2.1.5.RELEASE</spring-boot.version>
        <data-mongodb.version>2.1.8.RELEASE</data-mongodb.version>
        <curator.version>4.0.1</curator.version>
        <lombok.version>1.18.8</lombok.version>
        <rabbit.version>2.1.4.RELEASE</rabbit.version>
        <hutool.version>5.7.17</hutool.version>
        <base.version>1.0-SNAPSHOT</base.version>
        <eureka.version>2.1.3.RELEASE</eureka.version>
        <apollo.version>1.8.0</apollo.version>
        <servletapi.version>4.0.1</servletapi.version>
        <!--  设置编码格式，防止主程序启动报  java.nio.charset.MalformedInputException: Input length = 1  -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    </properties>


</project>
